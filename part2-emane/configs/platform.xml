<!--
  platform.xml – EMANE Platform Topology XML for 16-NEM TDMA Simulation

  Explicitly defines all 16 Network Emulation Modules (NEM 1 through 16).
  References nem.xml for MAC/PHY and transvirtual.xml for TAP transports.
-->
<platform>
  <param name="otamanagergroup" value="224.1.2.3:45702"/>
  <param name="otamanagerdevice" value="lo"/>
  <param name="eventservicemanagergroup" value="224.1.2.4:45703"/>
  <param name="eventservicemanagerdevice" value="lo"/>

  <!-- NEM 1 -->
  <nem id="1" definition="nem.xml">
    <transport definition="transvirtual.xml">
      <param name="device" value="emane1"/>
    </transport>
  </nem>

